{
  "name": "hhgym/fachdock",
  "description": "Open-source locker management and booking system for schools",
  "type": "project",
  "license": "AGPL-3.0-only",
  "require": {
    "php": ">=8.3",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "ext-pdo": "*",
    "ext-zip": "*",
    "monolog/monolog": "^3.0",
    "phpmailer/phpmailer": "^7.1"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.0",
    "phpstan/phpstan": "^2.0",
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "FachDock\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "FachDock\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse --memory-limit=1G",
    "cs-check": "php-cs-fixer fix --dry-run --diff",
    "check": [
      "@test",
      "@analyse",
      "@cs-check"
    ]
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true,
    "allow-plugins": {
      "php-http/discovery": false
    }
  }
}
