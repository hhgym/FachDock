{
  "name": "hhgym/fachdock",
  "description": "Open-source locker management and booking system for schools",
  "type": "project",
  "license": "AGPL-3.0-only",
  "require": {
    "php": ">=8.3"
  },
  "autoload": {
    "psr-4": {
      "FachDock\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "FachDock\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true
  }
}
