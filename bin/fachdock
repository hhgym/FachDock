#!/usr/bin/env php
<?php

declare(strict_types=1);

use FachDock\Backup\BackupService;
use FachDock\Booking\AllocationRuleEvaluator;
use FachDock\Config\Config;
use FachDock\Database\ConnectionFactory;
use FachDock\Installation\InstallationState;
use FachDock\Mail\MailQueueService;
use FachDock\Mail\MailTemplateRenderer;
use FachDock\Mail\MailWorkerFactory;
use FachDock\Migration\MigrationRunner;
use FachDock\Privacy\DataRetentionService;
use FachDock\SchoolYear\SchoolYearTransitionService;
use FachDock\System\WorkerHeartbeatService;

$root = dirname(__DIR__);
$autoload = $root . '/vendor/autoload.php';

if (!is_file($autoload)) {
    fwrite(STDERR, "Composer dependencies are missing.\n");
    exit(1);
}

require $autoload;

$command = $argv[1] ?? 'help';

if ($command === 'help' || $command === '--help' || $command === '-h') {
    echo "FachDock CLI\n\n";
    echo "Commands:\n";
    echo "  migrate                         Run all pending database migrations\n";
    echo "  mail:work                       Process one batch of queued emails\n";
    echo "  school-year:tick                Queue due renewal reminders and perform overdue August rollover\n";
    echo "  privacy:tick                    Apply configured retention and anonymization rules\n";
    echo "  backup:create                   Create a full local backup with SHA-256 checksum\n";
    echo "  backup:restore <file> --force   Restore a backup after creating a safety backup\n";
    exit(0);
}

$allowedCommands = [
    'migrate',
    'mail:work',
    'school-year:tick',
    'privacy:tick',
    'backup:create',
    'backup:restore',
];
if (!in_array($command, $allowedCommands, true)) {
    fwrite(STDERR, "Unknown command: {$command}\n");
    exit(2);
}

if (!(new InstallationState($root))->isInstalled()) {
    fwrite(STDERR, "FachDock is not installed yet. Use the web installer first.\n");
    exit(3);
}

try {
    $config = Config::load($root);
    $pdo = ConnectionFactory::fromConfig($config);

    if ($command === 'migrate') {
        $count = (new MigrationRunner($pdo, $root . '/migrations'))->migrate();
        echo $count === 1
            ? "1 migration applied.\n"
            : sprintf("%d migrations applied.\n", $count);
        exit(0);
    }

    if ($command === 'backup:create') {
        $result = (new BackupService($root, $pdo))->create();
        printf(
            "Backup created: %s (%d tables, %d rows, %d files)\nSHA-256: %s\n",
            $result['file'],
            $result['tables'],
            $result['rows'],
            $result['files'],
            $result['sha256'],
        );
        exit(0);
    }

    if ($command === 'backup:restore') {
        $backupFile = $argv[2] ?? '';
        $force = in_array('--force', $argv, true);
        if ($backupFile === '' || !$force) {
            fwrite(STDERR, "Usage: php bin/fachdock backup:restore <file> --force\n");
            exit(2);
        }
        $backup = new BackupService($root, $pdo);
        $safety = $backup->create();
        printf("Safety backup created: %s\n", $safety['file']);
        $result = $backup->restore($backupFile);
        printf(
            "Backup restored: %d tables, %d rows, %d files.\n",
            $result['tables'],
            $result['rows'],
            $result['files'],
        );
        exit(0);
    }

    if ($command === 'privacy:tick') {
        $heartbeat = new WorkerHeartbeatService($pdo, 'privacy');
        $heartbeat->started();
        try {
            $result = (new DataRetentionService($pdo))->anonymize(null);
            $heartbeat->succeeded($result);
        } catch (Throwable $exception) {
            $heartbeat->failed($exception->getMessage());
            throw $exception;
        }
        printf(
            "Privacy job: %d student(s), %d parent(s), %d mail(s), %d mail history row(s), %d audit row(s), %d incident(s) anonymized.\n",
            $result['students'],
            $result['parents'],
            $result['mails'],
            $result['mail_history'],
            $result['audit_entries'],
            $result['incidents'],
        );
        exit(0);
    }

    if ($command === 'school-year:tick') {
        $heartbeat = new WorkerHeartbeatService($pdo, 'school_year');
        $heartbeat->started();
        try {
            $service = new SchoolYearTransitionService(
                $pdo,
                new AllocationRuleEvaluator($pdo),
                new MailQueueService($pdo, new MailTemplateRenderer()),
                (string) $config->get('app.base_url', ''),
                (string) $config->get('app.school_name', ''),
            );
            $result = $service->dailyTick();
            $heartbeat->succeeded($result);
        } catch (Throwable $exception) {
            $heartbeat->failed($exception->getMessage());
            throw $exception;
        }
        printf(
            "School year job: %d reminder(s) queued, %d rollover(s) performed.\n",
            $result['reminders'],
            $result['rollovers'],
        );
        exit(0);
    }

    $intConfig = static function (Config $config, string $key, int $default): int {
        $value = $config->get($key, $default);

        return is_numeric($value) ? max(1, (int) $value) : $default;
    };

    $queue = new MailQueueService($pdo, new MailTemplateRenderer());
    $worker = (new MailWorkerFactory($config))->create($pdo, $queue);
    $heartbeat = new WorkerHeartbeatService($pdo, 'mail');
    $heartbeat->started();
    try {
        $result = $worker->run($intConfig($config, 'mail.worker_batch_size', 50));
        $heartbeat->succeeded($result);
    } catch (Throwable $exception) {
        $heartbeat->failed($exception->getMessage());
        throw $exception;
    }
    printf(
        "Mail worker: %d processed, %d sent, %d deferred, %d failed, %d expired.\n",
        $result['processed'],
        $result['sent'],
        $result['deferred'],
        $result['failed'],
        $result['expired'],
    );
    exit(0);
} catch (Throwable $exception) {
    fwrite(STDERR, ucfirst($command) . ' failed: ' . $exception->getMessage() . "\n");
    exit(1);
}
